<Application x:Class="Nota.Windows.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Microsoft.UI.Xaml.Controls">
  <Application.Resources>
    <ResourceDictionary>

      <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
              <SolidColorBrush x:Key="PaperBrush" Color="#FDFCF9" />
              <SolidColorBrush x:Key="SidebarBrush" Color="#F0EDE6" />
              <SolidColorBrush x:Key="BandBrush" Color="#E6E2DA" />
              <SolidColorBrush x:Key="LineBrush" Color="#D8D1C5" />
              <SolidColorBrush x:Key="InkBrush" Color="#25221F" />
              <SolidColorBrush x:Key="MutedBrush" Color="#6E685F" />
              <SolidColorBrush x:Key="DangerBrush" Color="#AF342B" />
              <SolidColorBrush x:Key="SelectionBrush" Color="#F2E0BE" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Default">
              <SolidColorBrush x:Key="PaperBrush" Color="#25221F" />
              <SolidColorBrush x:Key="SidebarBrush" Color="#211F1C" />
              <SolidColorBrush x:Key="BandBrush" Color="#35312C" />
              <SolidColorBrush x:Key="LineBrush" Color="#51493E" />
              <SolidColorBrush x:Key="InkBrush" Color="#F7F5F1" />
              <SolidColorBrush x:Key="MutedBrush" Color="#B9B0A4" />
              <SolidColorBrush x:Key="DangerBrush" Color="#F08C80" />
              <SolidColorBrush x:Key="SelectionBrush" Color="#574126" />
          </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="CaptureBrush" Color="#FFB340" />
      <SolidColorBrush x:Key="SignalBrush" Color="#DBA756" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#DBA756" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#E7B970" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C5964D" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#25221F" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#25221F" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#25221F" />
      <Style x:Key="QuietButton" TargetType="Button">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
          <Setter Property="Padding" Value="10,6" />
          <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style x:Key="QuietTextBox" TargetType="TextBox">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
          <Setter Property="SelectionHighlightColor" Value="{StaticResource SignalBrush}" />
          <Setter Property="Padding" Value="0,6" />
      </Style>

      <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/SourceSans3-Regular.ttf#Source Sans 3</FontFamily>
      <FontFamily x:Key="TextControlThemeFontFamily">ms-appx:///Assets/Fonts/SourceSans3-Regular.ttf#Source Sans 3</FontFamily>
      <ResourceDictionary.MergedDictionaries><controls:XamlControlsResources /></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
