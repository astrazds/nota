<Window x:Class="Nota.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nota">
    <Grid x:Name="Root" Background="{ThemeResource PaperBrush}" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="Notice" Grid.Row="0" IsOpen="False" IsClosable="True" />
        <ContentControl x:Name="Workspace" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="288" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="Sidebar" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="8" Padding="16,14,16,8">
                        <TextBlock Text="Nota" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Margin="0,0,0,2" />
                        <Button x:Name="NewButton" Click="New_Click" HorizontalAlignment="Stretch" Background="{StaticResource CaptureBrush}" Foreground="#25221F" BorderThickness="0" Padding="12,8" AutomationProperties.Name="New Note">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="＋  New Note" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Ctrl N" FontSize="11" VerticalAlignment="Center" Opacity="0.7" Margin="50,0,0,0" />
                            </Grid>
                        </Button>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="ThemeButton" Content="Theme: System" Click="Theme_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
                            <Button Grid.Column="1" Content="About" Click="About_Click" Style="{StaticResource QuietButton}" />
                        </Grid>
                        <TextBox x:Name="SearchBox" PlaceholderText="Search notes, #tags, title:..." TextChanged="Search_TextChanged" AutomationProperties.Name="Search notes" Background="{ThemeResource PaperBrush}" BorderBrush="{ThemeResource LineBrush}" CornerRadius="8" Padding="10,8" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TagFilters">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="NoteCount" Text="Notes" Foreground="{ThemeResource MutedBrush}" FontSize="12" Margin="16,12,16,8" />
                            <ListView x:Name="NoteList" SelectionChanged="NoteList_SelectionChanged" ItemClick="NoteList_ItemClick" Margin="8,0" IsItemClickEnabled="True" SelectionMode="Single" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,4" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="64" /><Setter Property="CornerRadius" Value="7" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,7,2,7">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InkBrush}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="⋮" Tag="{Binding Id}" Click="NoteActions_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Note actions" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="EmptyNotes" Text="A little room for your thoughts.&#xA;Create a note to start writing." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" Margin="18,8,18,24" />
                            <Border Background="{ThemeResource BandBrush}" Padding="16,9,8,9" Margin="0,28,0,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Recently Deleted" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                    <Button x:Name="ClearDeleted" Grid.Column="1" Content="Clear All" Click="ClearDeleted_Click" Style="{StaticResource QuietButton}" Foreground="{ThemeResource DangerBrush}" FontSize="11" />
                                </Grid>
                            </Border>
                            <StackPanel x:Name="DeletedRows" Background="{ThemeResource PaperBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,10">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="BackupHealth" Text="Opening notebook…" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export" Click="Export_Click" Style="{StaticResource QuietButton}" FontSize="12" />
                                <Button Content="Import" Click="Import_Click" Style="{StaticResource QuietButton}" FontSize="12" />
                                <Button Content="Restore" Click="Restore_Click" Style="{StaticResource QuietButton}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ContentControl x:Name="EditorPane" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid Background="{ThemeResource PaperBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Padding="28,12,28,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Button x:Name="BackButton" Content="‹  Notes" Click="Back_Click" Style="{StaticResource QuietButton}" Visibility="Collapsed" Margin="-8,0,0,4" />
                    <TextBox x:Name="TitleBox" Grid.Row="1" HorizontalContentAlignment="Stretch" PlaceholderText="Untitled note" Style="{StaticResource QuietTextBox}" FontSize="25" FontWeight="SemiBold" TextChanged="Editor_TextChanged" AutomationProperties.Name="Note title" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="TagsBox" Grid.Row="2" PlaceholderText="Add tags, separated by commas" Style="{StaticResource QuietTextBox}" FontSize="12" TextChanged="Editor_TextChanged" AutomationProperties.Name="Note tags" />
                </Grid>
                <Border x:Name="Toolbar" Grid.Row="1" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,1" Padding="22,2">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button Content="B" FontWeight="Bold" Tag="bold" Click="Format_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Bold" ToolTipService.ToolTip="Bold (Ctrl+B)" />
                        <Button Content="I" FontStyle="Italic" Tag="italic" Click="Format_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Italic" ToolTipService.ToolTip="Italic (Ctrl+I)" />
                        <Button Content="S̶" Tag="strikethrough" Click="Format_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Strikethrough" ToolTipService.ToolTip="Strikethrough" />
                        <Button Content="☐" Tag="task_list" Click="Format_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Task list" ToolTipService.ToolTip="Task list" />
                        <Button Content="▦" Tag="table" Click="Format_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Insert table" ToolTipService.ToolTip="Insert table" />
                    </StackPanel>
                </Border>
                <Grid x:Name="WritingArea" Grid.Row="2" Padding="28,16,28,12">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="WriteColumn" Width="*" /><ColumnDefinition x:Name="PreviewColumn" Width="0" /></Grid.ColumnDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="BodyMeasureColumn" Width="*" /></Grid.ColumnDefinitions><TextBox x:Name="BodyBox" HorizontalContentAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource QuietTextBox}" FontFamily="ms-appx:///Assets/Fonts/SourceCodePro-Regular.ttf#Source Code Pro" FontSize="14" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="Editor_TextChanged" AutomationProperties.Name="Markdown editor" HorizontalAlignment="Stretch" /></Grid>
                    <Grid x:Name="PreviewPane" Grid.Column="1" Visibility="Collapsed">
                        <WebView2 x:Name="PreviewWeb" Visibility="Collapsed" />
                        <StackPanel x:Name="PreviewMessage" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                            <TextBlock x:Name="PreviewMessageText" Text="Preparing preview…" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" />
                            <Button x:Name="InstallWebView" Content="Get Microsoft Edge WebView2 Runtime" Click="InstallWebView_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Border Grid.Row="3" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,7">
                    <Grid MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="WordCount" Text="Your notes stay on this device" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <ToggleButton x:Name="WriteMode" Content="Write" Tag="write" Click="Mode_Click" Padding="9,5" FontSize="12" IsChecked="True" />
                            <ToggleButton x:Name="PreviewMode" Content="Preview" Tag="preview" Click="Mode_Click" Padding="9,5" FontSize="12" />
                            <ToggleButton x:Name="SplitMode" Content="Split" Tag="split" Click="Mode_Click" Padding="9,5" FontSize="12" />
                            <Button Content="?" Click="Help_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Markdown help" />
                        </StackPanel>
                        <TextBlock x:Name="SaveStatus" Grid.Column="2" Text="" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,2,0" />
                    </Grid>
                </Border>
            </Grid>
            </ContentControl>
        </Grid>
        </ContentControl>
    </Grid>
</Window>
