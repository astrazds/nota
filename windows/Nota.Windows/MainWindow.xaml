<Window x:Class="Nota.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nota">
    <Grid x:Name="Root" Background="{ThemeResource PaperBrush}" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="TopBar" Height="62" Padding="23,0,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition x:Name="CaptionInset" Width="138" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <ToggleButton x:Name="NotesButton" Click="Notes_Click" Style="{StaticResource QuietToggle}" AutomationProperties.Name="Notes" ToolTipService.ToolTip="Notes (Ctrl+F)">
                    <StackPanel Orientation="Horizontal" Spacing="7"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M9,3 V21" Stroke="{ThemeResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox><TextBlock Text="Notes" FontSize="12" /></StackPanel>
                </ToggleButton>
                <Button x:Name="NewButton" Click="New_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="New note" ToolTipService.ToolTip="New note (Ctrl+N)"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M5,12 H19 M12,5 V19" Stroke="{ThemeResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox></Button>
            </StackPanel>
            <Grid x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent" />
            <TextBlock x:Name="Brand" Grid.ColumnSpan="4" Text="nota" FontSize="17" FontWeight="Normal" Foreground="{ThemeResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="-23,0,0,0" />
            <Button Grid.Column="2" Click="Settings_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings" VerticalAlignment="Center" Margin="0,0,12,0"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M10,5 H3 M12,19 H3 M14,3 V7 M16,17 V21 M21,12 H12 M21,19 H16 M21,5 H14 M8,10 V14 M8,12 H3" Stroke="{ThemeResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox></Button>
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" />
        <ContentControl x:Name="Workspace" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <SplitView x:Name="Library" DisplayMode="Overlay" IsPaneOpen="False" OpenPaneLength="278" CompactPaneLength="0" LightDismissOverlayMode="Off" PaneBackground="{ThemeResource SidebarBrush}" PaneOpening="Library_PaneOpening" PaneClosed="Library_PaneClosed">
                <SplitView.Pane>
                    <Grid x:Name="Sidebar" Padding="14,20,14,14" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,1,0" TabFocusNavigation="Cycle">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Margin="8,0,0,14"><TextBlock Text="Notes" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" /><Button Click="CloseNotes_Click" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" AutomationProperties.Name="Close notes"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="{ThemeResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox></Button></Grid>
                        <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Search notes" TextChanged="Search_TextChanged" AutomationProperties.Name="Search notes" Background="Transparent" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="10,8" ToolTipService.ToolTip="Search notes, #tags, title:... (Ctrl+F)" />
                        <StackPanel Grid.Row="2" Margin="0,16,0,14" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="AllNotesFilter" Content="All notes" IsChecked="True" Tag="all" Click="Filter_Click" Style="{StaticResource QuietToggle}" />
                                <ToggleButton x:Name="PinnedFilter" Content="Pinned" Tag="pinned" Click="Filter_Click" Style="{StaticResource QuietToggle}" />
                                <Button x:Name="ActiveTagFilter" Click="ClearTag_Click" Style="{StaticResource QuietButton}" FontSize="12" Padding="8,4" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer x:Name="LibraryScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Grid MinHeight="{Binding ViewportHeight, ElementName=LibraryScroll}">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Top">
                                    <Grid Margin="9,0,9,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="YOUR NOTES" FontSize="11" CharacterSpacing="60" Foreground="{ThemeResource MutedBrush}" />
                                        <TextBlock x:Name="NoteCount" Grid.Column="1" Text="0" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                                    </Grid>
                                    <ListView x:Name="NoteList" SelectionChanged="NoteList_SelectionChanged" ItemClick="NoteList_ItemClick" IsItemClickEnabled="True" SelectionMode="Single" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="4" /><Setter Property="MinHeight" Value="88" /></Style></ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate><DataTemplate>
                                            <Grid Padding="11,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InkBrush}" />
                                                    <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Date}" FontSize="11" Foreground="{ThemeResource MutedBrush}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Tag="{Binding Id}" Click="NoteActions_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Note actions" VerticalAlignment="Top" Padding="4,2"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M13,12 A1,1 0 1 0 11,12 A1,1 0 1 0 13,12 M20,12 A1,1 0 1 0 18,12 A1,1 0 1 0 20,12 M6,12 A1,1 0 1 0 4,12 A1,1 0 1 0 6,12" Stroke="{ThemeResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox></Button>
                                            </Grid>
                                        </DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="EmptyNotes" Text="No notes yet." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" Margin="9,16,9,24" />
                                </StackPanel>
                                <Border Grid.Row="1" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,10,0,0">
                                    <StackPanel>
                                        <Button x:Name="DeletedToggle" Click="Deleted_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Recently deleted">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7B8;" FontSize="14" /><TextBlock Grid.Column="1" Text="Recently deleted" FontSize="12" Margin="8,0,0,0" /><TextBlock x:Name="DeletedCount" Grid.Column="2" FontSize="12" Text="0" /></Grid>
                                        </Button>
                                        <StackPanel x:Name="DeletedContent" Visibility="Collapsed"><StackPanel x:Name="DeletedRows" /><Button x:Name="ClearDeleted" Content="Clear all" Click="ClearDeleted_Click" Style="{StaticResource QuietButton}" Foreground="{ThemeResource DangerBrush}" FontSize="11" /></StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                        <Border Grid.Row="4" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,9,0,0">
                            <Grid><Button Content="Backup" Click="Backup_Click" Style="{StaticResource QuietButton}" FontSize="12" /><Button Content="About Nota" Click="About_Click" Style="{StaticResource QuietButton}" FontSize="12" HorizontalAlignment="Right" /></Grid>
                        </Border>
                    </Grid>
                </SplitView.Pane>
                <ContentControl x:Name="EditorPane" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid Background="{ThemeResource PaperBrush}">
                        <Grid.RowDefinitions><RowDefinition x:Name="EditorToolsRow" Height="42" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel x:Name="NoteActions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,24,0" Spacing="2">
                            <Button x:Name="PinButton" Click="Pin_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Pin note" ToolTipService.ToolTip="Pin note"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M12,17 v5 M9,10.76 a2,2 0 0 1 -1.11,1.79 l-1.78,.9 A2,2 0 0 0 5,15.24 V16 a1,1 0 0 0 1,1 h12 a1,1 0 0 0 1,-1 v-.76 a2,2 0 0 0 -1.11,-1.79 l-1.78,-.9 A2,2 0 0 1 15,10.76 V7 a1,1 0 0 1 1,-1 a2,2 0 0 0 0,-4 H8 a2,2 0 0 0 0,4 a1,1 0 0 1 1,1 z" Stroke="{Binding Foreground, ElementName=PinButton}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox></Button>
                            <Button x:Name="SelectedActionsButton" Click="SelectedNoteActions_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Note actions" ToolTipService.ToolTip="Note actions"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M13,12 A1,1 0 1 0 11,12 A1,1 0 1 0 13,12 M20,12 A1,1 0 1 0 18,12 A1,1 0 1 0 20,12 M6,12 A1,1 0 1 0 4,12 A1,1 0 1 0 6,12" Stroke="{ThemeResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox></Button>
                        </StackPanel>
                        <Grid x:Name="NoteHeading" Grid.Row="1" MaxWidth="684" HorizontalAlignment="Stretch" Padding="42,44,42,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBox x:Name="TitleBox" PlaceholderText="Untitled note" Style="{StaticResource QuietTextBox}" FontFamily="{StaticResource ReadingFont}" FontSize="39" FontWeight="Normal" Padding="0" TextChanged="Editor_TextChanged" AutomationProperties.Name="Note title" />
                            <RichTextBlock Grid.Row="1" Margin="0,20,0,0" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="False"><Paragraph x:Name="MetadataParagraph">
                                <Run x:Name="NoteDate" />
                            </Paragraph></RichTextBlock>
                        </Grid>
                        <StackPanel x:Name="Toolbar" Grid.Row="2" MaxWidth="684" Orientation="Horizontal" HorizontalAlignment="Stretch" Padding="36,26,36,8" Spacing="3">
                            <Button Content="B" FontWeight="Bold" Tag="bold" Click="Format_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Bold" ToolTipService.ToolTip="Bold (Ctrl+B)" />
                            <Button Content="I" FontStyle="Italic" Tag="italic" Click="Format_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Italic" ToolTipService.ToolTip="Italic (Ctrl+I)" />
                            <Button Content="H₂" Tag="heading" Click="Format_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Heading" ToolTipService.ToolTip="Heading" />
                            <Border Width="1" Height="14" Background="{ThemeResource LineBrush}" Margin="7,0" />
                            <Button Tag="bullet_list" Click="Format_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Bullet list" ToolTipService.ToolTip="Bullet list"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M3,5 h.01 M3,12 h.01 M3,19 h.01 M8,5 h13 M8,12 h13 M8,19 h13" Stroke="{ThemeResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox></Button>
                            <Button Tag="task_list" Click="Format_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Task list" ToolTipService.ToolTip="Task list"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M13,5 h8 M13,12 h8 M13,19 h8 M3,17 l2,2 4,-4 M3,7 l2,2 4,-4" Stroke="{ThemeResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox></Button>
                            <Button Tag="link" Click="Format_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Link" ToolTipService.ToolTip="Link"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M10,13 a5,5 0 0 0 7.54,.54 l3,-3 a5,5 0 0 0 -7.07,-7.07 l-1.72,1.71 M14,11 a5,5 0 0 0 -7.54,-.54 l-3,3 a5,5 0 0 0 7.07,7.07 l1.71,-1.71" Stroke="{ThemeResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox></Button>
                        </StackPanel>
                        <ScrollViewer x:Name="WritingScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" ZoomMode="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid x:Name="WritingArea" MaxWidth="684" HorizontalAlignment="Center" Padding="42,31,42,24">
                            <Grid.RowDefinitions><RowDefinition x:Name="WriteRow" Height="*" /><RowDefinition x:Name="PreviewRow" Height="0" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="WriteColumn" Width="*" /><ColumnDefinition x:Name="SplitGapColumn" Width="0" /><ColumnDefinition x:Name="PreviewColumn" Width="0" /></Grid.ColumnDefinitions>
                            <RichEditBox x:Name="BodyBox" HorizontalContentAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource QuietRichEditBox}" FontFamily="{StaticResource ReadingFont}" FontSize="18" Padding="0" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="Editor_TextChanged" Paste="Body_Paste" ClipboardCopyFormat="PlainText" DisabledFormattingAccelerators="All" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AutomationProperties.Name="Markdown editor" />
                            <Grid x:Name="PreviewPane" Grid.Column="2" Visibility="Collapsed" BorderBrush="{ThemeResource LineBrush}">
                                <WebView2 x:Name="PreviewWeb" Visibility="Collapsed" />
                                <StackPanel x:Name="PreviewMessage" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"><TextBlock x:Name="PreviewMessageText" Text="Preparing preview…" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" /><Button x:Name="InstallWebView" Content="Get Microsoft Edge WebView2 Runtime" Click="InstallWebView_Click" Visibility="Collapsed" /></StackPanel>
                            </Grid>
                        </Grid>
                        </ScrollViewer>
                        <Grid Grid.Row="4" x:Name="EditorFooter" Padding="27,19" MinHeight="64" BorderBrush="{ThemeResource LineBrush}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="WordCount" Text="0 words" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <StackPanel x:Name="ViewModes" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4"><ToggleButton x:Name="WriteMode" Content="Write" Tag="write" Click="Mode_Click" Style="{StaticResource ModeToggle}" IsChecked="True" /><ToggleButton x:Name="PreviewMode" Content="Preview" Tag="preview" Click="Mode_Click" Style="{StaticResource ModeToggle}" /><ToggleButton x:Name="SplitMode" Content="Split" Tag="split" Click="Mode_Click" Style="{StaticResource ModeToggle}" /></StackPanel>
                            <StackPanel x:Name="SavedState" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="4" Height="4" Fill="{StaticResource SignalBrush}" VerticalAlignment="Center" /><TextBlock x:Name="SaveStatus" Text="Saved locally" FontSize="11" Foreground="{ThemeResource MutedBrush}" /></StackPanel>
                        </Grid>
                        <StackPanel x:Name="EmptyEditor" Grid.Row="1" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Visibility="Collapsed"><TextBlock Text="A little room for your thoughts." FontFamily="{StaticResource ReadingFont}" FontSize="24" Foreground="{ThemeResource InkBrush}" /><Button Content="New note" Click="New_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Center" /></StackPanel>
                        <Border x:Name="DrawerScrim" Grid.RowSpan="5" Background="{ThemeResource PaperBrush}" Opacity="0.8" IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </ContentControl>
            </SplitView>
        </ContentControl>
    </Grid>
</Window>
